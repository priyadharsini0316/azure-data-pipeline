model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

	expression Server = "sql-kpmg-kpmgprototype-466kwo.database.windows.net" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression Database = "sqldb-kpmg-pipeline" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table 'Dashboard Summary'
ref table 'Pipeline Runs'
ref table 'Pipeline Health'
