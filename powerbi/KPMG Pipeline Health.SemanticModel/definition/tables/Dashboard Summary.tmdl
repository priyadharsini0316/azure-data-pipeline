/// Single-row operational summary used for headline monitoring measures.
table 'Dashboard Summary'
	lineageTag: 405f258a-dbbc-46f6-bf41-a59cd7a04c1c

	/// Number of source tables registered in pipeline configuration.
	measure 'Total Configured Tables' = MAX('Dashboard Summary'[Total Configured Tables Value])
		formatString: #,##0
		lineageTag: 4fabc625-7e35-423c-b997-272e5eda242c

	/// Number of configured tables currently eligible for processing.
	measure 'Enabled Tables' = MAX('Dashboard Summary'[Enabled Tables Value])
		formatString: #,##0
		lineageTag: cb16e644-773f-4710-a49a-eb8d93fb3860

	/// Count of fully successful master-pipeline runs.
	measure 'Successful Runs' = MAX('Dashboard Summary'[Successful Runs Value])
		formatString: #,##0
		lineageTag: b62bbf43-99ba-4a72-a521-d0fe21670885

	/// Count of failed or partially successful master-pipeline runs.
	measure 'Failed or Partial Runs' = MAX('Dashboard Summary'[Failed or Partial Runs Value])
		formatString: #,##0
		lineageTag: 674815e4-5f45-4551-874e-f861520d775c

	/// Total source rows validated by successful table-load attempts.
	measure 'Rows Processed' = MAX('Dashboard Summary'[Rows Processed Value])
		formatString: #,##0
		lineageTag: ec408857-6b9b-4a38-ac20-45b67112d7c4

	/// Number of schema-change decisions currently awaiting approval.
	measure 'Pending Schema Changes' = MAX('Dashboard Summary'[Pending Schema Changes Value])
		formatString: #,##0
		lineageTag: 477c8bca-1260-4397-a0a1-270a6720bc48

	/// Number of reconciliation checks that returned FAIL.
	measure 'Reconciliation Failures' = MAX('Dashboard Summary'[Reconciliation Failures Value])
		formatString: #,##0
		lineageTag: 2a1e8b65-0eb2-4746-a6a6-2c2d8e42401f

	/// Average completed master-pipeline duration in seconds.
	measure 'Average Duration Seconds' = MAX('Dashboard Summary'[Average Duration Seconds Value])
		formatString: #,##0.00
		lineageTag: 21e3e631-5921-4d64-b5cb-33f377a747fc

	column 'Total Configured Tables Value'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 9ebd9c94-3672-4921-9346-00c9e97fe0bc
		summarizeBy: sum
		sourceColumn: TotalConfiguredTables

		annotation SummarizationSetBy = Automatic

